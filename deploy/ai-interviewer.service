[Unit]
Description=情报驱动 面试备战
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-interviewer
EnvironmentFile=/opt/ai-interviewer/.env.local
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
# Next.js 默认监听 3000，由 Caddy 反向代理并终止 TLS
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
